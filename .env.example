# -----------------------------------------------------------------------------
# Docker: copy to .env in this folder (repo root). No quotes around values.
# If your password contains @ # : or /, URL-encode it (e.g. @ → %40).
# -----------------------------------------------------------------------------

# Auth — Supabase. For Docker use the pooler URI (Connection pooling) — it has IPv4; direct "db.xxx.supabase.co" may be IPv6-only.
# Project Settings → Database → Connection string → URI (Session or Transaction pooler).
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Auth — JWT secret (change in production)
JWT_SECRET=your-secret-at-least-32-chars

# Auth — base URL for password-reset links in emails
RESET_LINK_BASE_URL=http://localhost:3000

# Google OAuth (optional — if unset, Google sign-in is disabled)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
GOOGLE_REDIRECT_FRONTEND_URL=http://localhost:3000/auth/callback
