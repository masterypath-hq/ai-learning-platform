# -----------------------------------------------------------------------------
# Copy to .env in this folder (repo root). No quotes around values.
# If your password contains @ # : or /, URL-encode it (e.g. @ → %40).
# Never commit .env — it is gitignored.
# -----------------------------------------------------------------------------

# =============================================================================
# Shared (auth, gateway, course)
# =============================================================================

# Required in production. Signs JWTs; gateway and course service verify with the same value.
JWT_SECRET=your-secret-at-least-32-chars

# =============================================================================
# Database (Supabase Postgres)
# =============================================================================

# Required for auth-service and course-service.
# Use Supabase Session pooler URI for Docker/Render (IPv4). See README Environment section.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: separate DB for course-service. Falls back to DATABASE_URL if unset.
# COURSE_DATABASE_URL=

# =============================================================================
# Redis (required for auth-service; used by gateway for rate limits)
# =============================================================================

# Local npm run dev:*     → redis://localhost:6379  (run: npm run dev:redis)
# Docker Compose          → redis://redis:6379      (set automatically in compose)
# Render / production     → paste URL from Render Redis or Upstash add-on
REDIS_URL=redis://localhost:6379

# =============================================================================
# Auth service (port 3001)
# =============================================================================

# PORT=3001

# Password-reset link in emails. Use gateway URL in Docker (redirects to frontend).
RESET_LINK_BASE_URL=http://localhost:4000

# Email (Resend). If unset, emails are logged to console only.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Google OAuth (optional — if unset, Google sign-in is disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
GOOGLE_REDIRECT_FRONTEND_URL=http://localhost:3000/auth/callback

# GitHub OAuth (optional — if unset, GitHub sign-in is disabled)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/v1/auth/github/callback

# =============================================================================
# API gateway (port 4000)
# =============================================================================

# PORT=4000

FRONTEND_URL=http://localhost:3000
FRONTEND_RESET_PASSWORD_PATH=/reset-password

AUTH_SERVICE_URL=http://localhost:3001
COURSE_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://localhost:5002
PROGRESS_SERVICE_URL=http://localhost:5004

FREE_TIER_DAILY_LIMIT=5
SIGN_IN_MAX_ATTEMPTS=5
SIGN_IN_WINDOW_SECONDS=900

# =============================================================================
# Course service (port 3003)
# =============================================================================

# PORT=3003

# Required for AI course generation
ANTHROPIC_API_KEY=

# =============================================================================
# Frontend (Next.js) — add when implemented
# =============================================================================

# NEXT_PUBLIC_API_URL=http://localhost:4000
