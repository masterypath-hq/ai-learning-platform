# -----------------------------------------------------------------------------
# Copy to .env in this folder (repo root). No quotes around values.
# If your password contains @ # : or /, URL-encode it (e.g. @ → %40).
# Never commit .env — it is gitignored.
# -----------------------------------------------------------------------------

# =============================================================================
# Shared (auth, gateway, course, ai, websocket)
# =============================================================================

# Required in production. Signs JWTs; gateway, course, ai-service, and websocket
# all verify with the same value.
JWT_SECRET=your-secret-at-least-32-chars

# Shared secret for service-to-service calls not meant for the public gateway
# (e.g. the course-catalog generation script calling ai-service and course-service
# directly). Checked via the x-internal-secret header.
INTERNAL_SERVICE_SECRET=your-internal-secret-at-least-32-chars

# =============================================================================
# Database (Supabase Postgres)
# =============================================================================

# Required for auth-service and course-service.
# Use Supabase Session pooler URI for Docker/Render (IPv4). See README Environment section.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: separate DB for course-service. Falls back to DATABASE_URL if unset.
# COURSE_DATABASE_URL=

# Optional: separate DB for ai-service (chat_sessions/chat_messages). Falls back to DATABASE_URL if unset.
# AI_DATABASE_URL=

# Optional: separate DB for assessment-service (quiz_attempts). Falls back to DATABASE_URL if unset.
# ASSESSMENT_DATABASE_URL=

# Optional: separate DB for progress-service (progress_records/streaks). Falls back to DATABASE_URL if unset.
# PROGRESS_DATABASE_URL=

# =============================================================================
# Redis (required for auth-service; used by gateway for rate limits)
# =============================================================================

# Local npm run dev:*     → redis://localhost:6379  (run: npm run dev:redis)
# Docker Compose          → redis://redis:6379      (set automatically in compose)
# Render / production     → paste URL from Render Redis or Upstash add-on
REDIS_URL=redis://localhost:6379

# =============================================================================
# Auth service (port 3001)
# =============================================================================

# PORT=3001

# Password-reset link in emails. Use gateway URL in Docker (redirects to frontend).
RESET_LINK_BASE_URL=http://localhost:4000

# Email (Resend). If unset, emails are logged to console only.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Google OAuth (optional — if unset, Google sign-in is disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
GOOGLE_REDIRECT_FRONTEND_URL=http://localhost:3000/auth/callback

# GitHub OAuth (optional — if unset, GitHub sign-in is disabled)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/v1/auth/github/callback

# =============================================================================
# Billing (Stripe for USD, Paystack for NGN — Stage 8, part of auth-service)
# =============================================================================

# Stripe (https://dashboard.stripe.com/test/apikeys). If unset, Stripe checkout
# fails at request time but the service still boots.
STRIPE_SECRET_KEY=
# From `stripe listen` (local dev) or the Dashboard's webhook endpoint (prod).
STRIPE_WEBHOOK_SECRET=
# Price id for the Pro monthly plan (Dashboard → Product catalog).
STRIPE_PRICE_ID_PRO=

# Paystack (https://dashboard.paystack.com/#/settings/developers). No official
# Node SDK — auth-service calls the REST API directly via fetch.
PAYSTACK_SECRET_KEY=
# Plan code for the Pro monthly plan (Dashboard → Plans) — this, not
# PRO_PRICE_NGN below, is the actual amount charged; keep them in sync manually.
PAYSTACK_PLAN_CODE=

# Display-only prices shown on the pricing page (NGN is a flat number, not
# live-FX-converted — see CLAUDE.md product rules).
PRO_PRICE_USD=19
PRO_PRICE_NGN=25000

# Where Stripe/Paystack checkout redirects after payment, and where the Stripe
# customer portal returns to.
BILLING_SUCCESS_URL=http://localhost:3000/billing/success
BILLING_CANCEL_URL=http://localhost:3000/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:3000/settings

# =============================================================================
# API gateway (port 4000)
# =============================================================================

# PORT=4000

FRONTEND_URL=http://localhost:3000
FRONTEND_RESET_PASSWORD_PATH=/reset-password

AUTH_SERVICE_URL=http://localhost:3001
COURSE_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://localhost:5002
PROGRESS_SERVICE_URL=http://localhost:5004
ASSESSMENT_SERVICE_URL=http://localhost:5005
# Not proxied — used only by the gateway's /api/health aggregator.
WEBSOCKET_URL=http://localhost:4001

FREE_TIER_DAILY_LIMIT=5
SIGN_IN_MAX_ATTEMPTS=5
SIGN_IN_WINDOW_SECONDS=900

# =============================================================================
# Course service (port 3003)
# =============================================================================

# PORT=3003

# =============================================================================
# AI service (port 5002) — chat tutor + course/quiz generation (Stage 3+)
# =============================================================================

# PORT=5002

# Only ai-service calls the Anthropic API at runtime (chat tutor + course-content
# generation, see scripts/generate-course-catalog.ts; and quiz/quiz-grading generation).
ANTHROPIC_API_KEY=

# Verifies incoming JWTs (see Shared section above). Also used to sign chat session
# access for the websocket handshake.
# JWT_SECRET=

# ai-service fetches lesson/module/course content from here to ground quiz generation.
# COURSE_SERVICE_URL=

# =============================================================================
# Progress service (port 5004) — dashboard, streaks, badges (Stage 6)
# =============================================================================

# PORT=5004

# Consumes lesson/course content (for completion %) and enrollments — see the
# COURSE_SERVICE_URL/ASSESSMENT_SERVICE_URL entries above and below.
# COURSE_SERVICE_URL=
# ASSESSMENT_SERVICE_URL=

# =============================================================================
# Assessment service (port 5005) — knowledge checks, quizzes (Stage 5)
# =============================================================================

# PORT=5005

# assessment-service calls ai-service directly (bypassing the gateway) to generate
# module/course-final quizzes and grade short answers, authenticated via
# INTERNAL_SERVICE_SECRET (see Shared section above).
# AI_SERVICE_URL=

# =============================================================================
# Websocket service (port 4001) — AI token streaming (Stage 3)
# =============================================================================

# PORT=4001

# Verifies the JWT clients send on socket connection (see Shared section above).
# JWT_SECRET=

# =============================================================================
# Frontend (Next.js, port 3000) — Stage 7
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4001

# Display-only — mirror PRO_PRICE_USD/PRO_PRICE_NGN above (public marketing numbers).
NEXT_PUBLIC_PRO_PRICE_USD=19
NEXT_PUBLIC_PRO_PRICE_NGN=25000
