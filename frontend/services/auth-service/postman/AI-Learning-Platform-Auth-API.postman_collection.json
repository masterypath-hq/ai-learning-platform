{
  "info": {
    "name": "AI Learning Platform — Auth API",
    "description": "All requests go through the **API gateway** (default `http://localhost:4000`). Paths use **`/api/auth/...`** (no `/v1`); the gateway rewrites to `/api/v1/auth/...` on the auth service.\n\n**Variables**\n- `baseUrl` — gateway URL (default `http://localhost:4000`)\n- `authServiceUrl` — optional; only if you bypass the gateway and call auth directly on port 3001\n- `accessToken` / `refreshToken` — set by Tests on **Sign in** / **Sign up** / **Refresh tokens**\n\n**Password reset emails:** Set `RESET_LINK_BASE_URL=http://localhost:4000` in `.env` so links look like `http://localhost:4000/reset-password?token=…`. The gateway **redirects** to `FRONTEND_URL/reset-password?token=…` (SPA). Your app then calls `POST /api/auth/reset-password` on the gateway.\n\n**Google OAuth:** Register the callback URL in Google Cloud Console (e.g. `http://localhost:4000/api/auth/google/callback` when using the gateway).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "authServiceUrl", "value": "http://localhost:3001" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Gateway health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Gateway health: `{ \"status\": \"ok\", \"service\": \"gateway\" }`. Auth service has its own `/health` on `{{authServiceUrl}}` only if you call it directly."
      }
    },
    {
      "name": "Sign up",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j.tokens?.accessToken) pm.collectionVariables.set('accessToken', j.tokens.accessToken);",
              "  if (j.tokens?.refreshToken) pm.collectionVariables.set('refreshToken', j.tokens.refreshToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"name\": \"Jane Doe\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/sign-up",
        "description": "`POST /api/auth/sign-up` → auth service `/api/v1/auth/sign-up`.\n\n**Success (200):** `userId`, `email`, `tokens` (access + refresh + expiries)."
      }
    },
    {
      "name": "Sign in",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j.tokens?.accessToken) pm.collectionVariables.set('accessToken', j.tokens.accessToken);",
              "  if (j.tokens?.refreshToken) pm.collectionVariables.set('refreshToken', j.tokens.refreshToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/sign-in",
        "description": "`POST /api/auth/sign-in` — public; no Bearer token."
      }
    },
    {
      "name": "Refresh tokens",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j.tokens?.accessToken) pm.collectionVariables.set('accessToken', j.tokens.accessToken);",
              "  if (j.tokens?.refreshToken) pm.collectionVariables.set('refreshToken', j.tokens.refreshToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/refresh",
        "description": "Public — no JWT. Body: `{ \"refreshToken\": \"...\" }`."
      }
    },
    {
      "name": "Get me (profile)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/auth/me",
        "description": "Protected — gateway validates JWT, then forwards to auth. Profile cached in Redis (15 min) in auth service."
      }
    },
    {
      "name": "Google Sign-In — Redirect",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/google",
        "description": "Open in a **browser**. Ensure `GOOGLE_REDIRECT_URI` matches this flow (e.g. `http://localhost:4000/api/auth/google/callback`)."
      }
    },
    {
      "name": "Google Sign-In — Callback",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/google/callback?code=<auth-code-from-google>&state=<state-param>",
        "description": "Normally called by Google, not Postman."
      }
    },
    {
      "name": "Forgot password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/forgot-password",
        "description": "Public. Email link is built from `RESET_LINK_BASE_URL` + `/reset-password?token=…` (set base to `http://localhost:4000` so the link hits the gateway; gateway redirects to the frontend)."
      }
    },
    {
      "name": "Reset password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"<token-from-email-link>\",\n  \"newPassword\": \"NewSecurePass456!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/reset-password",
        "description": "Public."
      }
    },
    {
      "name": "Optional — Auth service health (direct)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{authServiceUrl}}/health",
        "description": "Bypasses gateway. Use only for debugging; production clients should use the gateway only."
      }
    }
  ]
}
