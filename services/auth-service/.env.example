# -----------------------------------------------------------------------------
# Auth Service — copy to .env and fill in values
# -----------------------------------------------------------------------------

# Database (required for Supabase or remote Postgres)
# Get from: Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xmpmzovfqfsoyhlnzfqj.supabase.co:5432/postgres

# JWT signing secret (required in production; use a long random string)
# Dev default: "dev-secret-change-in-production"
JWT_SECRET=

# Base URL for password-reset links in emails (optional)
# If unset, derived from request Host header (e.g. http://localhost:3000)
RESET_LINK_BASE_URL=https://your-app.com

# Port the service listens on (optional; default 3001)
PORT=3001

# Resend (email delivery). If not set, emails are logged to console.
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# "From" address — must be verified in Resend, or use the sandbox address below
RESEND_FROM_ADDRESS=onboarding@resend.dev
