{
  "name": "@ai-learning-platform/ai-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ENV_FILE_PATH=../../.env tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up --migrations-dir db/migrations --migrations-table pgmigrations_ai --envPath ../../.env",
    "migrate:down": "node-pg-migrate down --migrations-dir db/migrations --migrations-table pgmigrations_ai --envPath ../../.env",
    "migrate:create": "node-pg-migrate create --migrations-dir db/migrations --migrations-table pgmigrations_ai --envPath ../../.env -j js",
    "migrate:fake": "node-pg-migrate up --fake --migrations-dir db/migrations --migrations-table pgmigrations_ai --envPath ../../.env"
  },
  "dependencies": {
    "@ai-learning-platform/shared": "*",
    "@anthropic-ai/sdk": "^0.52.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.6.2",
    "typescript": "^5.3.0"
  }
}
